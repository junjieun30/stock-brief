# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 공유/커밋하지 마세요.

# Claude 한국어 요약용 (필수 — 없으면 AI 요약만 생략되고 나머지는 정상 동작)
ANTHROPIC_API_KEY=

# yfinance 실패 시 fallback (선택)
#   Finnhub      https://finnhub.io/register        (무료, 분당 60회)
#   AlphaVantage https://www.alphavantage.co/support/#api-key  (무료, 분당 5회)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# 텔레그램 전송용 (선택)
#   1) 텔레그램에서 @BotFather 에게 /newbot → 토큰 발급
#   2) 만든 봇에게 아무 메시지나 보낸 뒤
#      https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
