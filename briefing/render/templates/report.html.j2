<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
<link rel="apple-touch-icon" href="./apple-touch-icon.png">
<meta name="theme-color" content="#eeece7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)">
<title>해외 시장 브리핑 · {{ brief.market_date }}</title>
<style>
  /* 안도 다다오에서 빌려온 것들 — 노출 콘크리트의 따뜻한 회백색, 목탄색 잉크,
     직각에 가까운 기하, 그림자 대신 가는 선과 여백. 색은 재료의 색만 쓴다. */
  :root{
    --bg:#eeece7;            /* 콘크리트 — 따뜻한 회백 */
    --panel:#f7f6f2;         /* 한 톤 밝은 면 */
    --line:#d9d5cc;          /* 거푸집 이음새 같은 가는 선 */
    --ink:#2b2925;           /* 목탄 */
    --muted:#807b71;         /* 마른 콘크리트 */
    --up:#a4442c;            /* 산화한 벽돌 — 상승 */
    --down:#44586e;          /* 쇳빛 남색 — 하락 */
    --flat:#8f8a80;
    --accent:#55504a;        /* 액센트도 무채색에 가깝게. 색이 아니라 농도로 말한다 */
    --shadow:0 1px 0 rgba(43,41,37,.05);
    --radius:2px;            /* 직각에 가까운 모서리 */
    --radius-lg:3px;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#1c1b19; --panel:#242220; --line:#3a3733; --ink:#e4e1da; --muted:#95908a;
           --up:#cf7a5f; --down:#8ba3bd; --flat:#87827a; --accent:#b5afa4; --shadow:none; }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:"Pretendard Variable","Pretendard","Malgun Gothic",-apple-system,"Segoe UI",sans-serif;
    font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1180px;margin:0 auto;padding:28px 20px 80px}
  header{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px;margin-bottom:22px}
  h1{font-size:22px;margin:0;letter-spacing:.02em;font-weight:700}
  .meta{color:var(--muted);font-size:13px}
  .meta b{color:var(--ink);font-weight:600}
  h2{font-size:13px;margin:40px 0 14px;letter-spacing:.14em;font-weight:600;
     display:flex;align-items:center;gap:9px}
  h2::before{content:"";width:10px;height:2px;background:var(--ink)}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--shadow)}
  .summary{padding:20px 22px;white-space:pre-wrap}
  .summary strong{display:block;margin-top:14px;margin-bottom:2px;font-size:12.5px;color:var(--muted);
    letter-spacing:.04em}
  .disclaimer{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line);
    font-size:12px;color:var(--muted);white-space:normal}
  .grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(178px,1fr))}
  .tile{padding:13px 15px;background:var(--panel);border:1px solid var(--line);
    border-radius:var(--radius-lg);box-shadow:var(--shadow)}
  .tile .n{font-size:12.5px;color:var(--muted);margin-bottom:5px}
  .tile .p{font-size:20px;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .tile .c{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;margin-top:2px}
  .up{color:var(--up)} .down{color:var(--down)} .flat{color:var(--flat)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius-lg);
    background:var(--panel);box-shadow:var(--shadow)}
  th,td{padding:10px 14px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--line)}
  th{font-size:12px;font-weight:600;color:var(--muted)}
  th:first-child,td:first-child{text-align:left}
  tbody tr:last-child td{border-bottom:none}
  td.num{font-variant-numeric:tabular-nums}
  .sym{color:var(--muted);font-size:12px;margin-left:6px}
  .bars{display:grid;gap:7px}
  .bar{display:grid;grid-template-columns:104px 1fr 82px;align-items:center;gap:10px;font-size:13.5px}
  .track{position:relative;height:20px;background:color-mix(in srgb,var(--line) 60%,transparent);
    border-radius:var(--radius)}
  .track i{position:absolute;top:0;bottom:0;left:50%;width:1px;background:var(--line)}
  .fill{position:absolute;top:2px;bottom:2px;border-radius:var(--radius)}
  .v{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}
  .pos{position:relative;width:84px;height:6px;
    background:color-mix(in srgb,var(--line) 70%,transparent);
    border-radius:3px;display:inline-block;vertical-align:middle}
  .pos b{position:absolute;top:-2px;width:2px;height:10px;background:var(--accent);border-radius:1px}
  .news{list-style:none;margin:0;padding:0}
  .news li{padding:13px 18px;border-bottom:1px solid var(--line)}
  .news li:last-child{border-bottom:none}
  .news a{color:var(--ink);text-decoration:none;font-weight:600;font-size:14.5px;line-height:1.5}
  .news a:hover{color:var(--accent)}
  .news .sub{margin-top:4px;font-size:12px;color:var(--muted);line-height:1.5;
    white-space:normal;word-break:break-word}
  .tag{display:inline-block;padding:1px 7px;border:1px solid var(--line);border-radius:var(--radius);
    color:var(--muted);font-size:11px;font-weight:600;margin-right:6px;letter-spacing:.03em}
  /* --- 상단 고정 섹션 내비 + 설치/맨위로 버튼 --- */
  .snav{position:sticky;top:0;z-index:50;display:flex;gap:6px;overflow-x:auto;
    margin:0 -20px 6px;padding:10px 20px;background:var(--bg);
    border-bottom:1px solid var(--line);scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .snav::-webkit-scrollbar{display:none}
  .snav a{flex:0 0 auto;padding:6px 13px;border:1px solid var(--line);border-radius:var(--radius);
    background:var(--panel);color:var(--muted);text-decoration:none;font-size:12.5px;font-weight:600;
    letter-spacing:.02em;white-space:nowrap}
  .snav a.cur{border-color:var(--ink);color:var(--ink)}
  .install{margin-left:auto;padding:7px 14px;border:1px solid var(--ink);border-radius:var(--radius);
    background:var(--ink);color:var(--bg);font-size:12.5px;font-weight:700;cursor:pointer;
    font-family:inherit}
  .totop{position:fixed;right:18px;bottom:18px;z-index:60;width:42px;height:42px;
    border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);
    color:var(--ink);font-size:17px;cursor:pointer;opacity:0;pointer-events:none;
    transition:opacity .2s;box-shadow:0 2px 10px rgba(43,41,37,.12)}
  .totop.show{opacity:1;pointer-events:auto}
  @media (max-width:620px){
    .wrap{padding:16px 14px 70px}
    .snav{margin:0 -14px 6px;padding:9px 14px}
    h2{margin:30px 0 12px}
    .reflect{margin-top:44px}
  }
  /* --- 장 여는 시간 --- */
  .krnote{font-size:11px;color:var(--muted);font-weight:500;letter-spacing:.02em}
  .hours{list-style:none;margin:0;padding:0}
  .hours li{display:grid;grid-template-columns:14px 168px 1fr auto;gap:10px;align-items:center;
    padding:9px 16px;border-bottom:1px solid var(--line);font-size:13.5px}
  .hours li:last-child{border-bottom:none}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--line)}
  .dot.on{background:var(--up)}
  .mname{font-weight:600}
  .mhours{color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .mstate{font-size:11.5px;font-weight:700;color:var(--muted);white-space:nowrap}
  .mstate.on{color:var(--up)}
  @media (max-width:560px){
    .hours li{grid-template-columns:14px 1fr auto;font-size:13px}
    .mhours{grid-column:2 / -1;grid-row:2;font-size:12px}
  }
  /* --- 급등락 알림 --- */
  .alerts{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:20px}
  .alert{display:flex;align-items:center;gap:9px;padding:10px 15px;border-radius:var(--radius-lg);
    background:var(--panel);border:1px solid var(--line);box-shadow:var(--shadow);font-size:14px}
  .alert.up{border-left:3px solid var(--up)} .alert.down{border-left:3px solid var(--down)}
  .alert .nm{font-weight:600} .alert .pc{font-weight:700;font-variant-numeric:tabular-nums}
  /* --- 일정 --- */
  .cal{list-style:none;margin:0;padding:0}
  .cal li{display:grid;grid-template-columns:74px 1fr;gap:14px;align-items:baseline;
    padding:12px 18px;border-bottom:1px solid var(--line)}
  .cal li:last-child{border-bottom:none}
  .dday{font-size:12px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
  .dday.soon{color:var(--up)}
  .cal .t{font-weight:600;font-size:14.5px}
  .cal .d{font-size:12.5px;color:var(--muted);margin-top:2px}
  .kind{display:inline-block;padding:0 6px;border-radius:var(--radius);font-size:11px;font-weight:600;
    margin-left:7px;background:color-mix(in srgb,var(--muted) 15%,transparent);color:var(--muted)}
  /* --- 종목별 뉴스 --- */
  .tnews{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(310px,1fr))}
  .tn{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-lg);
    box-shadow:var(--shadow);padding:13px 16px}
  .tn h3{margin:0 0 8px;font-size:13px;display:flex;align-items:baseline;gap:7px}
  .tn h3 .pc{font-size:12px;font-variant-numeric:tabular-nums}
  .tn a{display:block;color:var(--ink);text-decoration:none;font-size:13.5px;line-height:1.5;
    margin-bottom:6px}
  .tn a:last-child{margin-bottom:0}
  .tn a:hover{color:var(--accent)}
  .tn .src{color:var(--muted);font-size:11.5px}
  /* --- 오늘의 공부 --- */
  .learn{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}
  .lc{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-lg);
    box-shadow:var(--shadow);padding:16px 18px}
  .lc .badge{display:inline-block;padding:2px 9px;border-radius:var(--radius);font-size:11px;font-weight:700;
    background:color-mix(in srgb,var(--accent) 13%,transparent);color:var(--accent);margin-bottom:9px}
  .lc h3{margin:0 0 7px;font-size:17px;letter-spacing:-.01em}
  .lc p{margin:0 0 9px;font-size:14px;line-height:1.65}
  .lc .why{margin:0;padding-top:9px;border-top:1px dashed var(--line);
    font-size:13.5px;color:var(--muted);line-height:1.65}
  /* --- 내일의 기술 : 데이터 카드들과 다른 호흡. 책 한 페이지처럼 --- */
  .reflect{margin:64px 0 8px;padding:52px 44px;border-radius:0;
    background:var(--panel);
    border:0;border-top:2px solid var(--ink);border-bottom:1px solid var(--line)}
  .rlabel{font-size:11px;letter-spacing:.3em;color:var(--muted);font-weight:700;
    margin-bottom:30px;text-align:center}
  .bpart{font-size:12.5px;color:var(--muted);text-align:center;margin-bottom:10px}
  .btitle{margin:0 0 8px;font-size:24px;letter-spacing:-.01em;text-align:center;
    font-weight:800;word-break:keep-all}
  .bsub{font-size:14.5px;color:var(--muted);text-align:center;margin-bottom:14px;word-break:keep-all}
  .bhorizon{display:block;width:fit-content;margin:0 auto 30px;padding:3px 12px;border-radius:var(--radius);
    font-size:11.5px;font-weight:700;letter-spacing:.02em;
    background:transparent;border:1px solid var(--line);color:var(--muted)}
  .bhorizon.now{background:transparent;border:1px solid var(--ink);color:var(--ink)}
  .bbody{max-width:620px;margin:0 auto}
  .bbody p{margin:0 0 20px;font-size:15.5px;line-height:2.0;font-weight:430;word-break:keep-all;
    text-indent:1em}
  .bbody p:first-child{text-indent:0}
  .bbody p:first-child::first-letter{font-size:1.35em;font-weight:700;color:var(--ink)}
  .bnotes{max-width:620px;margin:30px auto 0;padding-top:26px;
    border-top:1px solid var(--line);
    display:grid;gap:18px}
  .bnote b{display:block;font-size:11.5px;color:var(--muted);letter-spacing:.12em;
    margin-bottom:5px}
  .bnote p{margin:0;font-size:13.5px;line-height:1.8;color:var(--ink);opacity:.88;
    word-break:keep-all}
  .bfoot{max-width:620px;margin:26px auto 0;font-size:11.5px;color:var(--muted);
    text-align:center;opacity:.85}
  @media (max-width:620px){
    .reflect{padding:34px 22px}
    .btitle{font-size:21px}
    .bbody p{font-size:15px}
  }
  .warn{padding:8px 16px;font-size:13px;color:var(--muted)}
  .cols{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(330px,1fr))}
  footer{margin-top:44px;padding-top:16px;border-top:1px solid var(--line);
    font-size:12px;color:var(--muted);line-height:1.7}
  footer .archive{color:var(--accent);text-decoration:none;font-size:13px;font-weight:600}
  footer .archive:hover{text-decoration:underline}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>해외 시장 데일리 브리핑</h1>
  <div class="meta">시장 기준일 <b>{{ brief.market_date or '미상' }}</b>
    · 생성 {{ brief.generated_at.strftime('%Y-%m-%d %H:%M') }} KST</div>
  <button id="install-btn" class="install" hidden>📲 앱으로 설치</button>
</header>

<nav class="snav" id="snav" aria-label="섹션 바로가기"></nav>

{% if brief.alerts %}
<div class="alerts">
{% for a in brief.alerts %}
  <div class="alert {{ a.direction }}">
    <span class="nm">{{ a.quote.name }}</span>
    <span class="pc {{ a.direction }}">{{ a.quote | pct }}</span>
    <span class="sym">{{ a.quote.symbol }}</span>
  </div>
{% endfor %}
</div>
{% endif %}

{% if brief.ai_summary %}
<div class="card summary">{{ brief.ai_summary | md_bold }}
  <div class="disclaimer">AI가 공개 데이터를 바탕으로 생성한 요약입니다. 사실관계는 원문 기사로 확인하세요.</div>
</div>
{% endif %}

<h2>장 여는 시간 <span class="krnote">한국시간 기준</span></h2>
<div class="card">
<ul class="hours" id="market-hours"></ul>
</div>
<script>
(function () {
  // 미국 서머타임: 3월 둘째 일요일 ~ 11월 첫째 일요일 (현지 기준)
  function nthSunday(year, month, nth) {          // month: 0-based
    var d = new Date(Date.UTC(year, month, 1));
    var first = (7 - d.getUTCDay()) % 7 + 1;      // 첫 일요일 날짜
    return first + (nth - 1) * 7;
  }
  function usDST(nowUTC) {
    var y = nowUTC.getUTCFullYear();
    var start = Date.UTC(y, 2, nthSunday(y, 2, 2), 7);    // 3월 둘째 일 02:00 EST = 07:00 UTC
    var end   = Date.UTC(y, 10, nthSunday(y, 10, 1), 6);  // 11월 첫째 일 02:00 EDT = 06:00 UTC
    return nowUTC >= start && nowUTC < end;
  }
  function euDST(nowUTC) {                                 // 3월 마지막 일 ~ 10월 마지막 일 01:00 UTC
    var y = nowUTC.getUTCFullYear();
    var lastSun = function (m) { var d = new Date(Date.UTC(y, m + 1, 0)); return d.getUTCDate() - d.getUTCDay(); };
    return nowUTC >= Date.UTC(y, 2, lastSun(2), 1) && nowUTC < Date.UTC(y, 9, lastSun(9), 1);
  }

  var now = new Date();
  var dst = usDST(now), edst = euDST(now);

  // 각 시장의 세션을 한국시간 분(minute) 구간으로 정의. 자정을 넘으면 두 구간으로 쪼갠다.
  function span(h1, m1, h2, m2) { return [h1 * 60 + m1, h2 * 60 + m2]; }
  var markets = [
    { name: "한국 (KRX)", hours: "09:00 ~ 15:30", sessions: [span(9,0,15,30)] },
    { name: "일본 (도쿄)", hours: "09:00 ~ 11:30 · 12:30 ~ 15:30", sessions: [span(9,0,11,30), span(12,30,15,30)] },
    { name: "중국 (상해)", hours: "10:30 ~ 12:30 · 14:00 ~ 16:00", sessions: [span(10,30,12,30), span(14,0,16,0)] },
    { name: "홍콩", hours: "10:30 ~ 13:00 · 14:00 ~ 17:00", sessions: [span(10,30,13,0), span(14,0,17,0)] },
    edst
      ? { name: "유럽 (런던·프랑크푸르트)", hours: "16:00 ~ 다음날 00:30", sessions: [span(16,0,24,0), span(0,0,0,30)] }
      : { name: "유럽 (런던·프랑크푸르트)", hours: "17:00 ~ 다음날 01:30", sessions: [span(17,0,24,0), span(0,0,1,30)] },
    dst
      ? { name: "미국 (뉴욕·나스닥)", hours: "22:30 ~ 다음날 05:00 (서머타임)", sessions: [span(22,30,24,0), span(0,0,5,0)] }
      : { name: "미국 (뉴욕·나스닥)", hours: "23:30 ~ 다음날 06:00", sessions: [span(23,30,24,0), span(0,0,6,0)] },
  ];

  // 지금 한국시간 (기기 시간대와 무관하게 UTC+9 로 계산)
  var kst = new Date(now.getTime() + 9 * 3600 * 1000);
  var mins = kst.getUTCHours() * 60 + kst.getUTCMinutes();
  var dow = kst.getUTCDay();                                // 한국시간 요일
  // 미국·유럽 야간 세션은 자정 이전 구간이 전날 개장분이므로 요일 판정을 단순화:
  // 주말(토 새벽 미국장 마감 후 ~ 월 아침)만 전부 휴장 처리한다.
  function isWeekendClosed(name) {
    if (dow === 0) return true;                             // 일요일 전부 휴장
    if (dow === 6) return !(name.indexOf("미국") === 0 || name.indexOf("유럽") === 0) ? true
                        : mins >= (dst ? 300 : 360);        // 토요일: 미국·유럽 새벽 마감분만 인정
    if (dow === 1 && (name.indexOf("미국") === 0 || name.indexOf("유럽") === 0))
      return mins < 960;                                    // 월요일 저녁 개장 전까지는 닫힘
    return false;
  }

  var ul = document.getElementById("market-hours");
  markets.forEach(function (m) {
    var open = !isWeekendClosed(m.name) && m.sessions.some(function (s) { return mins >= s[0] && mins < s[1]; });
    var li = document.createElement("li");
    li.innerHTML = '<span class="dot ' + (open ? "on" : "") + '"></span>'
      + '<span class="mname">' + m.name + '</span>'
      + '<span class="mhours">' + m.hours + '</span>'
      + '<span class="mstate ' + (open ? "on" : "") + '">' + (open ? "개장 중" : "장 마감") + "</span>";
    ul.appendChild(li);
  });
})();
</script>

<h2>주요 지수</h2>
<div class="grid">
{% for q in brief.indices %}
  <div class="tile">
    <div class="n">{{ q.name }}</div>
    <div class="p">{{ q | price }}</div>
    <div class="c {{ q.direction }}">{{ q | pct }}</div>
  </div>
{% endfor %}
</div>

{% if brief.global_indices %}
<h2>글로벌 증시</h2>
<div class="grid">
{% for q in brief.global_indices %}
  <div class="tile">
    <div class="n">{{ q.name }}</div>
    <div class="p">{{ q | price }}</div>
    <div class="c {{ q.direction }}">{{ q | pct }}</div>
  </div>
{% endfor %}
</div>
{% endif %}

{% if brief.fx %}
<h2>G10 통화</h2>
<div class="grid">
{% for q in brief.fx %}
  <div class="tile">
    <div class="n">{{ q.name }}</div>
    <div class="p">{{ q | price }}</div>
    <div class="c {{ q.direction }}">{{ q | pct }}</div>
  </div>
{% endfor %}
</div>
{% endif %}

<h2>매크로 · 환율 · 원자재</h2>
<div class="grid">
{% for q in brief.macro %}
  <div class="tile">
    <div class="n">{{ q.name }}</div>
    <div class="p">{{ q | price }}</div>
    <div class="c {{ q.direction }}">{{ q | pct }}</div>
  </div>
{% endfor %}
</div>

{% if brief.sectors %}
<h2>섹터별 등락</h2>
<div class="card" style="padding:16px 18px">
  <div class="bars">
  {% for q in sectors_sorted %}
    <div class="bar">
      <div>{{ q.name }}</div>
      <div class="track"><i></i>{{ q | sector_fill }}</div>
      <div class="v {{ q.direction }}">{{ q | pct }}</div>
    </div>
  {% endfor %}
  </div>
</div>
{% endif %}

{% if brief.watchlist %}
<h2>관심 종목</h2>
<div class="tablewrap">
<table>
  <thead><tr>
    <th>종목</th><th>종가</th><th>등락</th><th>52주 위치</th><th>고점 대비</th><th>거래량</th>
  </tr></thead>
  <tbody>
  {% for q in brief.watchlist %}
    <tr>
      <td>{{ q.name }}<span class="sym">{{ q.symbol }}</span></td>
      <td class="num">{{ q | price }}</td>
      <td class="num {{ q.direction }}"><b>{{ q | pct }}</b></td>
      <td>{{ q | pos_bar }}</td>
      <td class="num {{ 'down' if q.pct_from_high is not none and q.pct_from_high < -0.05 else 'flat' }}">{{ q | from_high }}</td>
      <td class="num">{{ q | vol }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

{% if brief.gainers or brief.losers %}
<h2>상승 · 하락 상위</h2>
<div class="cols">
  {% for label, rows in mover_tables %}
  <div class="tablewrap">
    <table>
      <thead><tr><th>{{ label }}</th><th>종가</th><th>등락</th></tr></thead>
      <tbody>
      {% for q in rows %}
        <tr>
          <td>{{ q.symbol }}</td>
          <td class="num">{{ q | price }}</td>
          <td class="num {{ q.direction }}"><b>{{ q | pct }}</b></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if brief.calendar %}
<h2>앞으로 예정된 일정</h2>
<div class="card">
<ul class="cal">
{% for e in brief.calendar %}
  <li>
    <span class="dday {{ 'soon' if (e.day - today).days <= 1 else '' }}">{{ e.d_day(today) }}</span>
    <span>
      <span class="t">{{ e.title }}</span><span class="kind">{{ '실적' if e.kind == 'earnings' else '지표' }}</span>
      {% if e.detail %}<div class="d">{{ e.detail }}</div>{% endif %}
    </span>
  </li>
{% endfor %}
</ul>
</div>
{% endif %}

{% if brief.news %}
<h2>주요 뉴스</h2>
<div class="card">
<ul class="news">
{% for n in brief.news %}
  <li>
    <a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.summary_ko or n.title }}</a>
    <div class="sub"><span class="tag">{{ n.source }}</span>{% if n.published %}{{ n.published.strftime('%m-%d %H:%M') }} UTC · {% endif %}{{ n.title }}</div>
  </li>
{% endfor %}
</ul>
</div>
{% endif %}

{% if brief.ticker_news %}
<h2>내 관심 종목 소식</h2>
<div class="tnews">
{% for q in brief.watchlist %}
{% if brief.ticker_news.get(q.symbol) %}
  <div class="tn">
    <h3>{{ q.name }}<span class="sym">{{ q.symbol }}</span>
      <span class="pc {{ q.direction }}">{{ q | pct }}</span></h3>
    {% for n in brief.ticker_news[q.symbol] %}
      <a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.summary_ko or n.title }}
        <span class="src">· {{ n.source }}</span></a>
    {% endfor %}
  </div>
{% endif %}
{% endfor %}
</div>
{% endif %}

{% if brief.lessons %}
<h2>오늘의 공부</h2>
<div class="learn">
{% for l in brief.lessons %}
  <div class="lc">
    <span class="badge">{{ '주식 용어' if l.kind == 'term' else '투자 심리' }}</span>
    <h3>{{ l.term }}</h3>
    <p>{{ l.plain }}</p>
    <p class="why">{{ l.why }}</p>
  </div>
{% endfor %}
</div>
{% endif %}

{% if brief.future %}
{% set f = brief.future %}
<section class="reflect book">
  <div class="rlabel">내일의 기술 · {{ f.number }} / {{ f.total }}</div>
  <div class="bpart">{{ f.part }}</div>
  <h3 class="btitle">{{ f.title }}</h3>
  <div class="bsub">{{ f.subtitle }}</div>
  <span class="bhorizon {{ 'now' if f.horizon == '이미 진행 중' }}">{{ f.horizon }}</span>
  <div class="bbody">
  {% for para in f.body %}
    <p>{{ para }}</p>
  {% endfor %}
  </div>
  <div class="bnotes">
    <div class="bnote"><b>미래학자들의 시선</b><p>{{ f.voices }}</p></div>
    <div class="bnote"><b>다르게 보는 시각</b><p>{{ f.counter }}</p></div>
    <div class="bnote"><b>어디에서 관찰되는가</b><p>{{ f.where }}</p></div>
  </div>
  <div class="bfoot">특정 종목·매매에 대한 이야기가 아닙니다. 흐름을 읽는 배경 지식으로 읽어주세요.</div>
</section>
{% endif %}

{% if brief.warnings %}
<h2>수집 경고</h2>
<div class="card warn"><ul>{% for w in brief.warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
{% endif %}

<footer>
  <a class="archive" href="./archive.html">지난 브리핑 보기 →</a><br><br>
  이 리포트는 공개된 시세·뉴스 데이터를 자동으로 수집해 정리한 <b>참고 자료</b>입니다.
  투자 자문이나 매매 권유가 아니며, 데이터에 지연·누락·오류가 있을 수 있습니다.
  투자 판단과 그 결과에 대한 책임은 이용자 본인에게 있습니다.<br>
  데이터: Yahoo Finance / Finnhub / Alpha Vantage · 뉴스: RSS 피드
</footer>

</div>
<button id="totop" class="totop" aria-label="맨 위로">↑</button>
<script>
  // 홈 화면 설치용 서비스워커. file:// 로 열었을 때는 조용히 건너뛴다.
  if ("serviceWorker" in navigator && location.protocol.startsWith("http")) {
    navigator.serviceWorker.register("./sw.js").catch(function () {});
  }

  // --- 섹션 바로가기: h2 를 훑어 상단 고정 칩 내비를 만든다 ---
  (function () {
    var nav = document.getElementById("snav");
    var heads = document.querySelectorAll("h2");
    heads.forEach(function (h, i) {
      var label = h.childNodes[0].textContent.trim();
      if (!label) return;
      h.id = "s" + i;
      var a = document.createElement("a");
      a.href = "#s" + i;
      a.textContent = label;
      a.addEventListener("click", function (e) {
        e.preventDefault();
        h.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      nav.appendChild(a);
    });
    // 스크롤 위치에 따라 현재 섹션 강조
    var links = nav.querySelectorAll("a");
    function mark() {
      var y = window.scrollY + 90, cur = 0;
      heads.forEach(function (h, i) { if (h.offsetTop <= y) cur = i; });
      links.forEach(function (a, i) { a.classList.toggle("cur", i === cur); });
    }
    window.addEventListener("scroll", mark, { passive: true });
    mark();
  })();

  // --- 맨 위로 버튼 ---
  (function () {
    var btn = document.getElementById("totop");
    window.addEventListener("scroll", function () {
      btn.classList.toggle("show", window.scrollY > 600);
    }, { passive: true });
    btn.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  })();

  // --- 앱 설치 버튼: 브라우저가 설치 가능하다고 알려줄 때만 나타난다 ---
  (function () {
    var deferred = null;
    var btn = document.getElementById("install-btn");
    window.addEventListener("beforeinstallprompt", function (e) {
      e.preventDefault();
      deferred = e;
      btn.hidden = false;
    });
    btn.addEventListener("click", function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function () { btn.hidden = true; deferred = null; });
    });
    window.addEventListener("appinstalled", function () { btn.hidden = true; });
  })();
</script>
</body>
</html>
